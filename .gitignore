# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.viewer-venv/
venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
.uv/

# Run outputs (never commit; they belong on the HF dataset)
run-output/
runs/
*.parquet
*.jsonl
# ...except test fixtures, which must travel with the repo
!tests/fixtures/**/*.jsonl

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# direnv
.direnv/
.envrc.local

# devenv
.devenv/

# Agent tooling state, written or delivered per machine. Most entries under
# .claude/skills/ arrive as symlinks into a local store, so committing one records
# a path that resolves nowhere else. This repo's own three skills are already
# tracked and stay tracked — an ignore rule never affects a tracked path — but a
# NEW repo-authored skill needs `git add -f`.
.agents/
.omo/
.claude/plans/
.claude/worktrees/
.claude/settings.local.json
.claude/skills/*

# Raw bench JSON, same rule as the run outputs above: it belongs on the dataset.
_bench-json/
